{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firestore.rules", "firestore.indexes.json", "README.md", "**/.*", "**/node_modules/**", "demo/**", "tests/**"],
    "headers": [
      { "source": "sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "js/firebase-config.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
